# ─────────────────────────────────────────────────────────────
#  Copy to `.env.local` and fill in your own values.
#  NEVER commit real keys — `.env*` is git-ignored.
# ─────────────────────────────────────────────────────────────

# Public Supabase project settings (safe to expose to the browser).
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xuxszxgmibstcdxyovtx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lEJv2C-TbjZYNhZ2y7wkYQ_qYFMZOU7

# Server-only key. Add your own secret key to `.env.local`.
# Supabase Dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
# Emails allowed into the dashboard (/dashboard).
# Comma-separated. Leave it empty to allow any signed-in user — set it in
# production so nobody else can sign up on the project and edit the content.
ADMIN_EMAILS=uosryahmed23@gmail.com

# Site URL — used for metadata, sitemap, OG tags and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://yousryahmed.dev

# How often the site re-reads the backend, in seconds.
# 60 = an edit in Supabase is live on the site within a minute.
# 0  = read fresh on every request (more database traffic).
CONTENT_REVALIDATE=60
